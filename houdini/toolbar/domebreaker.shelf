<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- This file contains definitions of shelves, toolbars, and tools.
 It should not be hand-edited when it is being used by the application.
 Note, that two definitions of the same element are not allowed in
 a single file. -->

  <toolshelf name="domebreaker" label="DomeBreaker">
    <memberTool name="domebreaker_open_panel"/>
    <memberTool name="domebreaker_reload_tool"/>
    <memberTool name="splatforge_open_panel"/>
  </toolshelf>

  <tool name="domebreaker_open_panel" label="DomeBreaker" icon="LOP_light">
    <helpText><![CDATA[
Open the DomeBreaker UI Panel in a single clean floating window or bring existing panel to front.
]]></helpText>
    <script scriptType="python"><![CDATA[
import sys
import hou

# Ensure module is reloaded if needed
for mod in ["hdri_match_solaris.panel_ui", "hdri_match_solaris", "domebreaker"]:
    if mod in sys.modules:
        import importlib
        try:
            importlib.reload(sys.modules[mod])
        except Exception:
            pass

target_interfaces = ["domebreaker_panel", "hdri_match_panel"]
interface_name = None
for iface in target_interfaces:
    if iface in hou.pypanel.interfaces():
        interface_name = iface
        break

if not interface_name:
    hou.ui.displayMessage(
        "DomeBreaker panel interface not found.\nPlease restart Houdini to register the new package.", 
        severity=hou.severityType.Error
    )
else:
    interface = hou.pypanel.interfaces()[interface_name]
    desk = hou.ui.curDesktop()
    found_pane = None

    # 1. Search docked pane tabs in current desktop
    for pane in desk.paneTabs():
        if pane.type() == hou.paneTabType.PythonPanel:
            act = pane.activeInterface()
            if act and act.name() in target_interfaces:
                found_pane = pane
                break

    # 2. Search floating panel windows
    if not found_pane:
        for fp in desk.floatingPanels():
            for p in fp.panes():
                for tab in p.tabs():
                    if tab.type() == hou.paneTabType.PythonPanel:
                        act = tab.activeInterface()
                        if act and act.name() in target_interfaces:
                            found_pane = tab
                            break
                if found_pane:
                    break
            if found_pane:
                break

    if found_pane:
        found_pane.setIsCurrentTab()
        try:
            fp = found_pane.pane().floatingPanel()
            if fp:
                fp.activate()
        except Exception:
            pass
    else:
        panel_pane = desk.createFloatingPaneTab(hou.paneTabType.PythonPanel, position=(400, 200), size=(420, 800))
        panel_pane.setActiveInterface(interface)
]]></script>
  </tool>

  <tool name="splatforge_open_panel" label="SPLATFORGE" icon="SOP_attribreorient">
    <helpText><![CDATA[
Open the standalone SPLATFORGE panel for Gaussian Splat environment reconstruction.
]]></helpText>
    <script scriptType="python"><![CDATA[

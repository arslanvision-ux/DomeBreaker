<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="domebreaker" label="DomeBreaker">
    <memberTool name="domebreaker_open_panel"/>
    <memberTool name="domebreaker_reload_tool"/>
  </toolshelf>

  <tool name="domebreaker_open_panel" label="DomeBreaker" icon="LOP_light">
    <helpText><![CDATA[
Open the DomeBreaker UI Panel in a single clean floating window or bring existing panel to front.
]]></helpText>
    <script scriptType="python"><![CDATA[
import sys
import hou

# Ensure module is reloaded if needed
for mod in ["hdri_match_solaris.panel_ui", "hdri_match_solaris", "domebreaker"]:
    if mod in sys.modules:
        import importlib
        try:
            importlib.reload(sys.modules[mod])
        except Exception:
            pass

target_interfaces = ["domebreaker_panel", "hdri_match_panel"]
interface_name = None
for iface in target_interfaces:
    if iface in hou.pypanel.interfaces():
        interface_name = iface
        break

if not interface_name:
    hou.ui.displayMessage(
        "DomeBreaker panel interface not found.\nPlease restart Houdini to register the new package.", 
        severity=hou.severityType.Error
    )
else:
    interface = hou.pypanel.interfaces()[interface_name]
    desk = hou.ui.curDesktop()
    found_pane = None

    # 1. Search docked pane tabs in current desktop
    for pane in desk.paneTabs():
        if pane.type() == hou.paneTabType.PythonPanel:
            act = pane.activeInterface()
            if act and act.name() in target_interfaces:
                found_pane = pane
                break

    # 2. Search floating panel windows
    if not found_pane:
        for fp in desk.floatingPanels():
            for p in fp.panes():
                for tab in p.tabs():
                    if tab.type() == hou.paneTabType.PythonPanel:
                        act = tab.activeInterface()
                        if act and act.name() in target_interfaces:
                            found_pane = tab
                            break
                if found_pane:
                    break
            if found_pane:
                break

    if found_pane:
        found_pane.setIsCurrentTab()
        try:
            fp = found_pane.pane().floatingPanel()
            if fp:
                fp.activate()
        except Exception:
            pass
    else:
        panel_pane = desk.createFloatingPaneTab(hou.paneTabType.PythonPanel, position=(400, 200), size=(420, 800))
        panel_pane.setActiveInterface(interface)
]]></script>
  </tool>

  <tool name="domebreaker_reload_tool" label="Reload DomeBreaker" icon="BUTTONS_reload">
    <helpText><![CDATA[
Reload all DomeBreaker & HDRI modules and refresh the open panel.
]]></helpText>
    <script scriptType="python"><![CDATA[
import sys
import importlib
import hou

modules = [
    "hdri_match_solaris.oiio_adapter",
    "hdri_match_solaris.pipeline",
    "hdri_match_solaris.sun_detector",
    "hdri_match_solaris.light_extractor",
    "hdri_match_solaris.gaussian_splat",
    "hdri_match_solaris.lop_splat",
    "hdri_match_solaris.renderer_materials",
    "hdri_match_solaris.hdri_room_analyzer",
    "hdri_match_solaris.panel_ui",
    "hdri_match_solaris",
    "domebreaker",
    "hdri_match.io.loader",
    "hdri_match.analysis.hdri_stats",
    "hdri_match.core.pipeline",
    "hdri_match.core.projection",
    "hdri_match.core.inpaint",
    "hdri_match",
]

reloaded = []
for m in modules:
    if m in sys.modules:
        try:
            importlib.reload(sys.modules[m])
            reloaded.append(m)
        except Exception:
            pass

target_interfaces = ["domebreaker_panel", "hdri_match_panel"]
desk = hou.ui.curDesktop()
all_panes = [p for p in desk.paneTabs() if p.type() == hou.paneTabType.PythonPanel]
for fp in desk.floatingPanels():
    for p in fp.panes():
        for tab in p.tabs():
            if tab.type() == hou.paneTabType.PythonPanel:
                all_panes.append(tab)

for pane in all_panes:
    act = pane.activeInterface()
    if act and act.name() in target_interfaces:
        iface_name = act.name()
        other_ifaces = [i for i in hou.pypanel.interfaces().keys() if i != iface_name]
        if other_ifaces:
            try:
                pane.setActiveInterface(hou.pypanel.interfaces()[other_ifaces[0]])
            except Exception:
                pass
        pane.setActiveInterface(hou.pypanel.interfaces()[iface_name])

hou.ui.setStatusMessage(f"DomeBreaker: reloaded {len(reloaded)} modules and rebuilt panel.", severity=hou.severityType.Message)
print(f"[DomeBreaker] Reloaded: {', '.join(reloaded)}")
]]></script>
  </tool>
</shelfDocument>
